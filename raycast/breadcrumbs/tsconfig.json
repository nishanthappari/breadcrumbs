{
  "compilerOptions": {
    "lib": ["ES2022"], "module": "commonjs", "target": "ES2022", "strict": true,
    "isolatedModules": true, "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true, "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}
